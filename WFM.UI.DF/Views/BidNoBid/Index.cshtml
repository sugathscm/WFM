@{
    ViewBag.Title = "Bid / No-Bid Decision List";
}

<script type="text/javascript">
    $(document).ready(function () {
        $('#List').DataTable({
            "paging": true,
            "ajax": {
                "url": "/BidNoBid/GetList",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                {
                    "data": "ProjectId", "searchable": false, "ordering": false,
                    "render": function (data, type, full, meta) {
                        return '<a href="/PublicSectorTender/Details/' + data + '">' + full.ProjectCode + '</a>';
                    }
                },
                { "data": "ProjectName" },
                { "data": "StrategicFit", "searchable": false },
                { "data": "WinProbability", "searchable": false },
                { "data": "TechCapability", "searchable": false },
                { "data": "Resource", "searchable": false },
                { "data": "Profitability", "searchable": false },
                { "data": "ClientRelationship", "searchable": false },
                { "data": "Risks", "searchable": false },
                { "data": "Total", "searchable": false },
                {
                    "data": "Decision",
                    "render": function (data, type, full, meta) {
                        if (data == "GO")
                            return '<span class="badge badge-success">GO</span>';
                        else if (data == "NO-BID / REVIEW")
                            return '<span class="badge badge-danger">NO-BID / REVIEW</span>';
                        else
                            return '';
                    }
                },
                { "data": "Notes" }
            ]
        });
    });
</script>

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content ">
        <!-- ============================================================== -->
        <!-- pageheader  -->
        <!-- ============================================================== -->
        @Html.Partial("_PageHeaderPartial")
        <!-- ============================================================== -->
        <!-- end pageheader  -->
        <!-- ============================================================== -->
        <div class="border border-primary bg-actual-white">
            <div class="row col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-b-10">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-t-20">
                    <div class="table-responsive">
                        <table id="List" class="table table-striped table-bordered first">
                            <thead>
                                <tr>
                                    <th>Ref</th>
                                    <th>Opportunity</th>
                                    <th>Strategic Fit /20</th>
                                    <th>Win Prob /20</th>
                                    <th>Tech Capability /20</th>
                                    <th>Resource /15</th>
                                    <th>Profitability /10</th>
                                    <th>Client Rel /10</th>
                                    <th>Risks /5</th>
                                    <th>Total /100</th>
                                    <th>Decision</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
