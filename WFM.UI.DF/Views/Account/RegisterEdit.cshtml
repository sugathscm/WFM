@model WFM.UI.DF.Models.RegisterEditViewModel
@{
    ViewBag.Title = "Edit User";
}

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content ">
        <!-- ============================================================== -->
        <!-- pageheader  -->
        <!-- ============================================================== -->
        @Html.Partial("_PageHeaderPartial")
        <!-- ============================================================== -->
        <!-- end pageheader  -->
        <!-- ============================================================== -->
        <div class="border border-primary bg-actual-white">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-b-10">
                @using (Html.BeginForm("RegisterEdit", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    <hr />
                    @Html.ValidationSummary("", new { @class = "text-danger" })

                    <div class="form-row">
                        <div class="col-xl-2 col-lg-2 col-md-2 col-sm-12 col-12 ">
                            @Html.LabelFor(m => m.Email, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-2 col-sm-12 col-12 ">
                            @Html.LabelFor(m => m.EmployeeId, new { @class = "control-label" })<span style="color:red">&nbsp;*</span>
                            @Html.DropDownListFor(m => m.EmployeeId, new SelectList(Model.Employees.Items, "Id", "Name"), "Select Employee ", new { @class = "form-control form-select", required = "required" })
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-2 col-sm-12 col-12 ">
                            @Html.LabelFor(m => m.RoleId, new { @class = "control-label" })<span style="color:red">&nbsp;*</span>
                            @Html.DropDownListFor(m => m.RoleId, new SelectList(Model.Roles.Items, "Id", "Name"), "Select Role ", new { @class = "form-control form-select", required = "required" })
                        </div>
                        @*<div class="col-xl-2 col-lg-2 col-md-2 col-sm-12 col-12 ">
                            <label>Change Password:</label><br /> <input type="checkbox" id="pw" class="pw" />
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-4 col-sm-12 col-12 password">
                            @Html.LabelFor(m => m.Password, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.Password, new { @class = "form-control", @type = "password" })
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-4 col-sm-12 col-12 password">
                            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.ConfirmPassword, new { @class = "form-control", @type = "password" })
                        </div>*@
                        <div class="col-xl-1 col-lg-1 col-md-1 col-sm-12 col-12 ">
                            <label class="control-label" for="RoleId">&nbsp;</label><br />
                            <input type="submit" class="btn btn-primary" value="Save" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
$(document).ready(function () {
    $('#EmployeeId').select2({
        selectOnClose: true
    });

    $('#RoleId').select2({
        selectOnClose: true
    });

    $('.password').hide();

    // $('#pw').change(function () {
    //     if ($(this).is(':checked')) {
    //         $('.password').show();
    //     } else {
    //         $('.password').hide();
    //     }
    // });
});
    </script>
}
