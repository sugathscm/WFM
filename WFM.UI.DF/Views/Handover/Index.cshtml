@{
    ViewBag.Title = "Handover Register";
}

<script type="text/javascript">
    var checklistItems = [
        { key: "H1", label: "Signed contract and award letter on file" },
        { key: "H2", label: "Terms of Reference and final proposal transferred" },
        { key: "H3", label: "Approved budget and cash-flow shared" },
        { key: "H4", label: "Team mobilisation plan agreed" },
        { key: "H5", label: "Client focal points and contacts confirmed" },
        { key: "H6", label: "Risk register carried over from bid" },
        { key: "H7", label: "Kick-off meeting with delivery team held" },
        { key: "H8", label: "WBS and baseline schedule prepared" }
    ];
    var currentProjectId = null;

    $(document).ready(function () {
        LoadHandovers();
    });

    function statusBadge(status) {
        if (status == "READY")
            return '<span class="badge badge-success">READY</span>';
        return '<span class="badge badge-warning">NOT READY</span>';
    }

    function LoadHandovers() {
        if ($.fn.DataTable.isDataTable('#List')) {
            $('#List').DataTable().destroy();
        }
        $('#List').DataTable({
            "paging": true,
            "ajax": {
                "url": "/Handover/GetList",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "ProjRef" },
                { "data": "ProjectName" },
                { "data": "Client" },
                {
                    "data": "ContractValue", "searchable": false,
                    "render": $.fn.dataTable.render.number(',', '.', 2, ''), className: "dt-body-right"
                },
                { "data": "StartDate", "searchable": false },
                { "data": "EndDate", "searchable": false },
                { "data": "PMName" },
                { "data": "HandoverDone", "searchable": false },
                {
                    "data": "HandoverStatus", "searchable": false,
                    "render": function (data) { return statusBadge(data); }
                },
                {
                    "data": "Id", "searchable": false, "ordering": false,
                    "render": function (data, type, full, meta) {
                        return '<button type="button" class="btn btn-xs btn-outline-primary open-checklist" data-id="' + data + '">Checklist</button>';
                    }
                }
            ]
        });
    }

    $(document).on('click', '.open-checklist', function () {
        currentProjectId = $(this).data('id');
        $.ajax({
            url: '/Handover/GetChecklist',
            type: 'GET',
            data: { projectId: currentProjectId },
            success: function (handover) {
                var rows = '';
                for (var i = 0; i < checklistItems.length; i++) {
                    var item = checklistItems[i];
                    var checked = handover[item.key] === true ? 'checked' : '';
                    var note = handover[item.key + 'Note'] || '';
                    rows += '<tr>' +
                        '<td>H.' + (i + 1) + '</td>' +
                        '<td>' + item.label + '</td>' +
                        '<td class="text-center"><input type="checkbox" class="handover-item" data-key="' + item.key + '" ' + checked + ' /></td>' +
                        '<td><input type="text" class="form-control form-control-sm handover-note" data-key="' + item.key + 'Note" value="' + note + '" /></td>' +
                        '</tr>';
                }
                $('#ChecklistBody').html(rows);
                $('#ChecklistStatus').html(statusBadge(handover.HandoverStatus || 'NOT READY'));
                $('#HandoverModal').modal('show');
            }
        });
    });

    $(document).on('click', '#SaveChecklistBtn', function () {
        var handover = { ProjectId: currentProjectId };
        $('.handover-item').each(function () {
            handover[$(this).data('key')] = $(this).is(':checked');
        });
        $('.handover-note').each(function () {
            handover[$(this).data('key')] = $(this).val();
        });

        $.ajax({
            url: '/Handover/SaveChecklist',
            type: 'POST',
            data: addAntiForgeryToken({ handover: handover }),
            success: function (result) {
                $('#ChecklistStatus').html(statusBadge(result.handoverStatus));
                $('#HandoverModal').modal('hide');
                LoadHandovers();
            }
        });
    });

    function addAntiForgeryToken(data) {
        data.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();
        return data;
    }
</script>

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content ">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="page-header">
                    <h2 class="pageheader-title">@ViewBag.Title</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="List" class="table table-striped table-bordered first">
                                <thead>
                                    <tr>
                                        <th style="width:8%">Proj ref</th>
                                        <th>Project / assignment</th>
                                        <th>Client</th>
                                        <th>Contract value</th>
                                        <th>Start date</th>
                                        <th>End date</th>
                                        <th>Project Manager</th>
                                        <th>Handover done</th>
                                        <th>Handover status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@using (Html.BeginForm("", "", FormMethod.Post))
{
    @Html.AntiForgeryToken()
}

<div class="modal fade" id="HandoverModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Handover checklist</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th style="width:8%">Item ref</th>
                            <th>Handover item</th>
                            <th style="width:10%">Done</th>
                            <th style="width:30%">Note</th>
                        </tr>
                    </thead>
                    <tbody id="ChecklistBody"></tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-right"><strong>Handover status</strong></td>
                            <td id="ChecklistStatus"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" id="SaveChecklistBtn">Save</button>
            </div>
        </div>
    </div>
</div>
