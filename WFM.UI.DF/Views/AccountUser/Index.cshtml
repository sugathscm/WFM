@model IEnumerable<WFM.UI.DF.ModelsView.UsersInRoleViewModel>

@{
    ViewBag.Title = "User Management";
}

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content ">
        <!-- ============================================================== -->
        <!-- pageheader  -->
        <!-- ============================================================== -->
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="page-header">
                    <h2 class="pageheader-title">@ViewBag.Title</h2>
                    <div class="page-breadcrumb">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                @*<li class="breadcrumb-item"><a href="#" class="breadcrumb-link">Dashboard</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">E-Commerce Dashboard Template</li>*@
                            </ol>
                        </nav>
                    </div>
                </div>
                @if (TempData["Message"] != null)
                {
                    @Html.Raw(TempData["Message"])
                }
            </div>
        </div>
        <!-- ============================================================== -->
        <!-- end pageheader  -->
        <!-- ============================================================== -->
        <div class="row" style="background-color:#fff">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-t-20">
                <div class="form-group">
                    @{
                        if (User.IsInRole("Administrator"))
                        {
                            <input type="button" value="Add User" onclick="location.href='/Account/Register'" class="btn btn-success" />
                        }
                    }
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                        <table class="table table-striped table-bordered first" id="UserList">
                            <thead>
                                <tr>
                                    <th style="width:20%">Username</th>
                                    <th style="width:20%">Email</th>
                                    <th style="width:20%">Employee</th>
                                    <th style="width:10%">Roles</th>
                                    <th style="width:10%">Lockout Enabled</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </thead>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.Username</td>
                                    <td>@user.Email</td>
                                    <td>@user.Employee</td>
                                    <td>@user.Role</td>
                                    <td>@user.LockoutEnabled</td>
                                    <td>
                                        @{
                                            if (User.IsInRole("Administrator"))
                                            {
                                                <button type="button" class="btn btn-primary" value="Edit" onclick="editUser('@user.UserId')">Edit</button>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @{
                                            if (User.IsInRole("Administrator"))
                                            {
                                                <button type="button" class="btn btn-warning" value="Edit" onclick="editUserP('@user.UserId')">Change PW</button>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @{
                                            if (User.IsInRole("Administrator"))
                                            {
                                                if (@user.LockoutEnabled == "Yes")
                                                {
                                                    <button type="button" class="btn btn-secondary" value="Edit" onclick="activateUser('@user.UserId')">Activate</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-danger" value="Edit" onclick="deactivateUser('@user.UserId')">Deactivate</button>
                                                }
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </table>
                    </div>
                    <div class="panel-footer">
                        <p class="box-title"><b>Total Users till @String.Format("{0 : dddd, MMMM d, yyyy}", DateTime.Now) : </b><span class="label label-primary">@Model.Count()</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(function () {
            $("#UserList").DataTable({
                paging: false
            });
        });

        function editUser(userId) {
            location.href = '/Account/RegisterEdit/' + userId;
        }

        function editUserP(userId) {
            location.href = '/Account/ChangePassword/' + userId;
        }

        function deactivateUser(userId) {
            //alert(userId);

            $.ajax({
                "url": "/AccountUser/DeactivateUser",
                "type": "POST",
                "datatype": "json",
                "dataSrc": "",
                "data": {
                    "id": userId,
                },
                success: function (data) {
                    if (data.Status === 1) {
                        location.href = '/AccountUser';
                    } else {
                        alert("Error while updating data.");
                    }
                },
                error: function () {
                    alert("Error while updating data.");
                }
            });
        }

        function activateUser(userId) {
            //alert(userId);

            $.ajax({
                "url": "/AccountUser/ActivateUser",
                "type": "POST",
                "datatype": "json",
                "dataSrc": "",
                "data": {
                    "id": userId,
                },
                success: function (data) {
                    if (data.Status === 1) {
                        location.href = '/AccountUser';
                    } else {
                        alert("Error while updating data.");
                    }
                },
                error: function () {
                    alert("Error while updating data.");
                }
            });
        }

    </script>
}
