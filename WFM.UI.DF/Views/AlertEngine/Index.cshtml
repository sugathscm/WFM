@{
    ViewBag.Title = "Deadline Alert Engine";
}

<script type="text/javascript">
    $(document).ready(function () {
        LoadAlerts();

        $('#AlertWindowDays').on('change', function () {
            LoadAlerts();
        });

        $(document).on('click', '.send-alert', function () {
            var btn = $(this);
            var id = btn.data('id');

            $.ajax({
                url: '/AlertEngine/SendAlert',
                type: 'POST',
                data: {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (result) {
                    if (result.Status == 1) {
                        btn.replaceWith('<span class="badge badge-secondary">Sent</span>');
                    } else {
                        alert(result.Message);
                    }
                },
                error: function () {
                    alert('Send failed.');
                }
            });
        });
    });

    function LoadAlerts() {
        $.ajax({
            url: '/AlertEngine/GetList',
            type: 'POST',
            datatype: 'json',
            success: function (result) {
                var rows = result.data;
                var inAlert = 0, overdue = 0;
                var tbody = $('#AlertBody');
                tbody.empty();

                $.each(rows, function (i, row) {
                    if (row.Overdue) overdue++; else inAlert++;

                    var sendBtn = row.Overdue
                        ? '<button type="button" class="btn btn-sm btn-danger send-alert" data-id="' + row.Id + '">SEND - OVERDUE</button>'
                        : '<button type="button" class="btn btn-sm btn-outline-success send-alert" data-id="' + row.Id + '">SEND</button>';

                    tbody.append(
                        '<tr class="' + (row.Overdue ? 'table-danger' : 'table-warning') + '">' +
                        '<td>' + row.ProjectCode + '</td>' +
                        '<td>' + row.ProjectName + '</td>' +
                        '<td>' + row.OwnerName + '</td>' +
                        '<td>' + row.Deadline + '</td>' +
                        '<td>' + row.DaysLeft + '</td>' +
                        '<td>' + sendBtn + '</td>' +
                        '<td><small><b>Subject:</b> ' + row.Subject + '<br /><b>Body:</b> ' + row.Body + '</small></td>' +
                        '</tr>'
                    );
                });

                $('#InAlertCount').text(inAlert);
                $('#OverdueCount').text(overdue);
            }
        });
    }
</script>

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content ">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="page-header">
                    <h2 class="pageheader-title">@ViewBag.Title</h2>
                </div>
            </div>
        </div>
        <div class="border border-primary bg-actual-white">
            <div class="row col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-b-10 m-t-10">
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 mb-0">
                    <div class="form-group row">
                        <label class="col-lg-12 col-sm-12 col-form-label text-small">Alert window (days before deadline)</label>
                        <div class="col-lg-12 col-sm-12">
                            <input type="text" id="AlertWindowDays" class="form-control" value="@ViewBag.AlertWindowDays" readonly />
                            <small class="text-muted">Set in Administration &gt; Control Settings</small>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-3 col-sm-6 col-12 mb-0">
                    <div class="form-group row">
                        <label class="col-lg-12 col-sm-12 col-form-label text-small">In alert</label>
                        <div class="col-lg-12 col-sm-12">
                            <h3 id="InAlertCount" class="text-warning">0</h3>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-3 col-sm-6 col-12 mb-0">
                    <div class="form-group row">
                        <label class="col-lg-12 col-sm-12 col-form-label text-small">Overdue</label>
                        <div class="col-lg-12 col-sm-12">
                            <h3 id="OverdueCount" class="text-danger">0</h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Ref</th>
                                            <th>Proposal</th>
                                            <th>Owner</th>
                                            <th>Deadline</th>
                                            <th>Days left</th>
                                            <th>Send alert?</th>
                                            <th>Email preview (subject &middot; body)</th>
                                        </tr>
                                    </thead>
                                    <tbody id="AlertBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
