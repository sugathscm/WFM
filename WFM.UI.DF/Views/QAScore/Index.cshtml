@{
    ViewBag.Title = "QA Score List";
}

<script type="text/javascript">
    $(document).ready(function () {
        $('#List').DataTable({
            "paging": true,
            "ajax": {
                "url": "/QAScore/GetList",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                {
                    "data": "ProjectId", "searchable": false, "ordering": false,
                    "render": function (data, type, full, meta) {
                        return '<a href="/PublicSectorTender/Details/' + data + '">' + full.ProjectCode + '</a>';
                    }
                },
                { "data": "ProjectName" },
                { "data": "RfpTorCompliance", "searchable": false },
                { "data": "MethodologyApproach", "searchable": false },
                { "data": "KeyExpertsCv", "searchable": false },
                { "data": "RelevantExperience", "searchable": false },
                { "data": "WorkPlanDeliverables", "searchable": false },
                { "data": "MandatoryAttachments", "searchable": false },
                { "data": "FinancialCompetitiveness", "searchable": false },
                { "data": "ProposalQuality", "searchable": false },
                { "data": "FinalQcSubmissionReadiness", "searchable": false },
                { "data": "Total", "searchable": false },
                {
                    "data": "Decision",
                    "render": function (data, type, full, meta) {
                        if (data == "GO")
                            return '<span class="badge badge-success">GO</span>';
                        else if (data == "REVIEW")
                            return '<span class="badge badge-danger">REVIEW</span>';
                        else
                            return '';
                    }
                },
                { "data": "Notes" }
            ]
        });
    });
</script>

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content ">
        <!-- ============================================================== -->
        <!-- pageheader  -->
        <!-- ============================================================== -->
        @Html.Partial("_PageHeaderPartial")
        <!-- ============================================================== -->
        <!-- end pageheader  -->
        <!-- ============================================================== -->
        <div class="border border-primary bg-actual-white">
            <div class="row col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-b-10">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-t-20">
                    <div class="table-responsive">
                        <table id="List" class="table table-striped table-bordered first">
                            <thead>
                                <tr>
                                    <th>Ref</th>
                                    <th>Opportunity</th>
                                    <th>RFP/TOR Compliance /20</th>
                                    <th>Methodology &amp; Approach /15</th>
                                    <th>Key Experts &amp; CV /20</th>
                                    <th>Relevant Experience /10</th>
                                    <th>Work Plan &amp; Deliverables /10</th>
                                    <th>All Mandatory Attachments /5</th>
                                    <th>Financial Competitiveness /10</th>
                                    <th>Proposal Quality /5</th>
                                    <th>Final QC &amp; Submission Readiness /5</th>
                                    <th>Total /100</th>
                                    <th>Decision</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
