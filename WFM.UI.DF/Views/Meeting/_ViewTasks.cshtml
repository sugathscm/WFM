@model List<WFM.DAL.GetTaskList_Result>

<div class="row p-2">
    <table id="List" class="table table-striped table-bordered first">
        <caption style="caption-side:top;background-color:#aaa;color:#000;"><h4>Tasks</h4></caption>
        <thead>
            <tr>
                <th style="width:5%">#</th>
                <th style="width:10%">Assigned<br />[Due Date]</th>
                <th style="width:10%">Priority<br />[Status]</th>
                <th style="width:10%">BU<br />[Type]</th>
                <th style="width:30%">Description</th>
                <th style="width:30%">Current Progress Note</th>
                <th style="width:5%">DR</th>
                @*<th></th>*@
            </tr>
        </thead>
        @foreach (var item in @Model)
        {
            <tr class="@item.ST">
                <td class="ml-2">@item.Id</td>
                <td class="ml-2">@Html.Raw(HttpUtility.HtmlDecode(item.strCreatedDate))</td>
                <td class="ml-2">@Html.Raw(HttpUtility.HtmlDecode(item.Priority))</td>
                <td class="ml-2">@Html.Raw(HttpUtility.HtmlDecode(item.TaskCategory))</td>
                <td class="ml-2 text-justify">@Html.Raw(HttpUtility.HtmlDecode(item.TaskDescription))</td>
                <td class="ml-2">@Html.Raw(HttpUtility.HtmlDecode(item.CurrentProgressNote))</td>
                <td class="ml-2">@item.DR</td>
                @*<td class="ml-2"><a class="btn btn-xs" href="/TaskTracker/Details/@item.Id" target="_blank"><img src="/assets/images/grid/e.png" width="30"></a></td>*@
            </tr>
        }
    </table>
</div>

<script>
    $(document).ready(function () {
    //    $('#List').DataTable();
    });
</script>

