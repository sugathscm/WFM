@model WFM.UI.DF.ModelsView.MeetingViewModel
@{
    ViewBag.Title = "Meeting Notes Management";
}

<script>
    $(document).ready(function () {
        $('select').select2({
            width: '100%',
            selectOnClose: true
        });

        LoadFileNotes();
        LoadMeetingNotes();
        LoadTasks();

        $('.fnsave').on('click', function () {
            SaveFileNote();
        });

        $('.mnsave').on('click', function () {
            SaveMeetingNote();

        });

        $('.tssave').on('click', function () {
            SaveTask();
            LoadTasks();
        });

        $('#FileNote_Date').datepicker({
            uiLibrary: 'bootstrap',
            "dateFormat": "mm/dd/yy"
        });
    });

    function ResetFileNote() {
        $("#FileNote_Note").val('');
        $("#FileNote_NoteGivenBy").val('');
        $("#FileNote_NoteTakenBy").val('');
        $("#FileNote_Date").val('');
    }
    function ResetMeetingNote() {
        $("#MeetingNote_Note").val('');
        $("#MeetingNote_NoteGivenBy").val('');
        $("#MeetingNote_NoteTakenBy").val('');
    }

    function SaveFileNote() {
        $.ajax({
            type: "POST",
            url: "/Meeting/SaveFileNote",
            data: {
                meetingId: $("#Id").val(),
                note: $("#FileNote_Note").val(),
                noteGivenBy: $("#FileNote_NoteGivenBy").val(),
                noteTakenBy: $("#FileNote_NoteTakenBy").val(),
                date: $("#FileNote_Date").val(),
                projectId: $("#FileNote_ProjectId").val(),
            },
            //contentType: "application/json; charset=utf-8",
            //dataType: "json",
            success: function (data) {
                ResetFileNote();
                LoadFileNotes();
            },
            error: function (err) {
                alert(err);
            }
        });
    }
    function SaveMeetingNote() {
        $.ajax({
            type: "POST",
            url: "/Meeting/SaveMeetingNote",
            data: {
                "meetingId": $("#Id").val(),
                "note": $("#MeetingNote_Note").val(),
                "noteGivenBy": $("#MeetingNote_NoteGivenBy").val(),
                "noteTakenBy": $("#MeetingNote_NoteTakenBy").val(),
            },
            //contentType: "application/json; charset=utf-8",
            //dataType: "json",
            success: function (r) {
                ResetMeetingNote();
                LoadMeetingNotes();
            },
            error: function (err) {
                alert(err);
            }
        });
    }
    function SaveTask() {

    }

    function LoadFileNotes()
    {
        var url = '@Url.Action("DisplayFileNotes", "Meeting")';
        var id = $('#Id').val();
        $('#MeetingFileNotes').load(url, { id: id });
    }
    function LoadMeetingNotes()
    {
        var url = '@Url.Action("DisplayMeetingNotes", "Meeting")';
        var id = $('#Id').val();
        $('#MeetingNotes').load(url, { id: id });
    }
    function LoadTasks()
    {
        var url = '@Url.Action("DisplayTasks", "Meeting")';
        var id = $('#Id').val();
        $('#Tasks').load(url, { id: id });
    }
</script>


<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content ">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary("", new { @class = "text-danger" })
        @Html.HiddenFor(m => m.Id, new { @name = "Id" })
        <!-- ============================================================== -->
        <!-- pageheader  -->
        <!-- ============================================================== -->
        <div class="row mb-1">
            <div class="col-xl-8 col-lg-8 col-md-11 col-sm-12 col-12">
                <div class="pagetitle">
                    <h3>@ViewBag.Title</h3>
                </div>
            </div>
            <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 text-right">
                @*<button class="cta-sm ml-2 btn btn-sm btn-primary" type="button" fdprocessedid="4w2c8q">In-Progress</button>
                    <button class="cta-sm ml-2 btn btn-sm btn-success" type="button" fdprocessedid="b6qtgf">Completed</button>
                    <button class="cta-sm ml-2 btn btn-sm btn-danger" type="button" fdprocessedid="b6qtgf">Cancel</button>*@
            </div>
        </div>
        <!-- ============================================================== -->
        <!-- end pageheader  -->
        <!-- ============================================================== -->
        <div class="border border-primary bg-actual-white">
            <div class="row mb-2 p-2">
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 m-b-10">
                    <label class="control-label"><b>Meeting Type</b></label><br />
                    @Html.TextBoxFor(m => m.MeetingTypeName, new { @class = "form-control", @disabled = "disabled" })
                </div>
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 m-b-10">
                    <label class="control-label"><b>Name</b></label><br />
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @disabled = "disabled" })
                </div>
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 m-b-10">
                    <label class="control-label"><b>Location</b></label><br />
                    @Html.TextBoxFor(m => m.Location, new { @class = "form-control", @disabled = "disabled" })
                </div>
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 m-b-10">
                    <label class="control-label"><b>Internal Participants</b></label><br />
                    @Html.TextAreaFor(m => m.InternalParticipantNames, new { @class = "form-control", @disabled = "disabled" })
                </div>
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 m-b-10">
                    <label class="control-label"><b>External Participants</b></label><br />
                    @Html.TextAreaFor(m => m.ExternalParticipants, new { @class = "form-control", @disabled = "disabled" })
                </div>
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 m-b-10">
                    <label class="control-label"><b>KPI's'</b></label><br />
                    @Html.TextAreaFor(m => m.KPI, new { @class = "form-control", @disabled = "disabled" })
                </div>
            </div>
            <hr />
            <div class="row mb-2 p-2">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-b-10">
                    <div class="tab-regular">
                        <ul class="nav nav-tabs nav-fill" id="MeetingMins" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="mn-tab-justify" data-toggle="tab" href="#mn-justif" role="tab" aria-controls="mn" aria-selected="true">Meeting Notes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="fn-tab-justify" data-toggle="tab" href="#fn-justif" role="tab" aria-controls="fn" aria-selected="true">File Notes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="ts-tab-justify" data-toggle="tab" href="#ts-justif" role="tab" aria-controls="ts" aria-selected="true">Tasks</a>
                            </li>
                        </ul>
                        <div class="tab-content" id="MeetingMins">
                            <div class="tab-pane fade show active" id="mn-justif" role="tabpanel" aria-labelledby="mn-tab-justify">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-2 p-2">
                                    <div class="row">
                                        <div class="col-xl-9 col-lg-9 col-md-12 col-sm-12 col-12 mb-2">
                                            <label class="control-label">Note Given By</label>
                                            @Html.TextBoxFor(m => m.MeetingNote.NoteGivenBy, new { @class = "form-control" })
                                        </div>
                                        <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12 mb-2">
                                            <label class="control-label">Note Taken By</label>
                                            @Html.DropDownListFor(model => model.MeetingNote.NoteTakenBy, new SelectList(ViewBag.EmployeeList, "Id", "Name"), "Select Taken By")
                                        </div>
                                        <div class="col-xl-11 col-lg-11 col-md-12 col-sm-12 col-12 mb-2">
                                            <label class="control-label">Note</label>
                                            @Html.TextAreaFor(m => m.MeetingNote.Note, new { @class = "form-control" })
                                        </div>
                                        <div class="col-xl-1 col-lg-1 col-md-12 col-sm-12 col-12 ">
                                            <label>&nbsp;</label><br />
                                            <input type="button" class="btn btn-xs btn-success mnsave" value="Save" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-0">
                                            <div id="MeetingNotes">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade show" id="fn-justif" role="tabpanel" aria-labelledby="fn-tab-justify">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-2 p-2">
                                    <div class="row">
                                        <div class="col-xl-2 col-lg-2 col-md-12 col-sm-12 col-12 mb-2">
                                            <label class="control-label">Date</label>
                                            @Html.TextBoxFor(model => model.FileNote.Date, new { @class = "form-control" })
                                        </div>
                                        <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12 mb-2">
                                            <label class="control-label">Project</label>
                                            @Html.DropDownListFor(model => model.FileNote.ProjectId, new SelectList(ViewBag.ProjectList, "Id", "Name"), "Select Project")
                                        </div>
                                        <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12 mb-2">
                                            <label class="control-label">Note Given By</label>
                                            @Html.DropDownListFor(model => model.FileNote.NoteGivenBy, new SelectList(ViewBag.EmployeeList, "Id", "Name"), "Select Given By")
                                        </div>
                                        <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12 mb-2">
                                            <label class="control-label">Note Taken By</label>
                                            @Html.DropDownListFor(model => model.FileNote.NoteTakenBy, new SelectList(ViewBag.EmployeeList, "Id", "Name"), "Select Taken By")
                                        </div>
                                        <div class="col-xl-11 col-lg-11 col-md-12 col-sm-12 col-12 mb-2">
                                            <label class="control-label">Note</label>
                                            @Html.TextAreaFor(m => m.FileNote.Note, new { @class = "form-control" })
                                        </div>
                                        <div class="col-xl-1 col-lg-1 col-md-12 col-sm-12 col-12 ">
                                            <label>&nbsp;</label><br />
                                            <input type="button" class="btn btn-xs btn-success fnsave" value="Save" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-0">
                                            <div id="MeetingFileNotes">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade show" id="ts-justif" role="tabpanel" aria-labelledby="ts-tab-justify">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-2 p-2">
                                    <div class="row">
                                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-0">
                                            <div id="Tasks">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
