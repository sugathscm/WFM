@model WFM.UI.DF.ModelsView.MeetingViewModel

@{
    ViewBag.Title = "Meeting Management";
}

<script type="text/javascript">
    $(document).ready(function () {
        LoadMeetings();
        $('.search').on('click', function () {
            LoadMeetings();
        });
    });

    function LoadMeetings() {
        $('#List').DataTable().destroy();

        table = $('#List').DataTable({
            "paging": true,
            "ajax": {
                "url": "/Meeting/GetList",
                "type": "POST",
                "datatype": "json",
                "data": {
                    "fromDate": $("#FromDate").val(),
                    "toDate": $("#ToDate").val(),
                    "typeId": $("#MeetingTypeId").val(),
                    "participantId": $("#ParticipantId").val(),
                    "Id": ""
                }
            },
            order: [[0, 'desc']],
            "columns": [
                { "data": "Id" },
                { "data": "strDate" },
                { "data": "TypeName" },
                { "data": "Location" },
                { "data": "ExternalParticipants" },
                { "data": "Participants" },
                {
                    "data": "Id", "searchable": false, "ordering": false,
                    "render": function (data, type, full, meta) {
                        return '<a class="btn btn-warning" target="_blank" href="/Meeting/Minutes/' + data + '">Minutes</a>';
                    }
                },
                {
                    "data": "Id", "searchable": false, "ordering": false,
                    "render": function (data, type, full, meta) {
                        return '<a class="btn btn-info" target="_blank" href="/Meeting/Details/' + data + '">Edit</a>';
                    }
                },
                {
                    "data": "Id", "searchable": false, "ordering": false,
                    "render": function (data, type, full, meta) {
                        return '<a class="btn btn-info" target="_blank" href="/Meeting/View/' + data + '">View</a>';
                    }
                },
            ]
        });
    }
</script>

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content ">
        <!-- ============================================================== -->
        <!-- pageheader  -->
        <!-- ============================================================== -->
        <!-- ============================================================== -->
        <!-- end pageheader  -->
        <!-- ============================================================== -->
        <div class="row mb-2">
            <div class="col-xl-10 col-lg-10 col-md-12 col-sm-12 col-12">
                <div class="pagetitle">
                    <h3>@ViewBag.Title</h3>
                </div>
            </div>
            <div class="col-xl-2 col-lg-2 col-md-12 col-sm-12 col-12 text-right">
                <div class="csc-btn float-end">
                    <a class="cta-sm ml-2 btn btn-primary" href="/Meeting/Details">New Meeting</a>
                </div>
            </div>
        </div>
        <div class="border border-primary bg-actual-white">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-b-10">
                <div class="row">
                    <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12 mb-0">
                        <div class="form-group row">
                            <label class="col-12 col-sm-12 col-form-label text-small">From Date (mm/dd/yyyy)</label>
                            <div class="col-lg-12 col-md-12 col-sm-12">
                                @Html.EditorFor(m => m.FromDate, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12 mb-0">
                        <div class="form-group row">
                            <label class="col-12 col-sm-12 col-form-label text-small">To Date (mm/dd/yyyy)</label>
                            <div class="col-lg-12 col-md-12 col-sm-12">
                                @Html.EditorFor(m => m.ToDate, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 mb-0">
                        <div class="form-group row">
                            <label class="col-12 col-sm-12 col-form-label text-small">Type</label>
                            <div class="col-lg-12 col-md-12 col-sm-12">
                                @Html.DropDownListFor(m => m.MeetingTypeId, new SelectList(ViewBag.MeetingTypeList, "Id", "Topic"), "All Types", new { @class = "form-select" })
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 mb-0">
                        <div class="form-group row">
                            <label class="col-12 col-sm-12 col-form-label text-small">Internal Participant</label>
                            <div class="col-lg-12 col-md-12 col-sm-12">
                                @Html.DropDownListFor(m => m.ParticipantId, new SelectList(ViewBag.ParticipantIdList, "Id", "Name"), "All Internal Participant", new { @class = "form-select" })
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-1 col-lg-1 col-md-12 col-sm-12 col-12 mb-0">
                        <div class="form-group row">
                            <label class="col-lg-12 col-sm-12 col-form-label text-small">&nbsp;</label>
                            <div class="col-lg-12 col-sm-12">
                                <button class="cta-sm ml-2 btn btn-sm search btn-success" type="button">Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="border border-primary bg-actual-white m-b-10 m-t-10">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-b-10 m-t-10">
                <div class="table-responsive">
                    <table id="List" class="table table-striped table-bordered first">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Location</th>
                                <th>Ext. Participants</th>
                                <th>Participants</th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $('#FromDate').datepicker({
            uiLibrary: 'bootstrap',
            "dateFormat": "mm/dd/yy"
        });
        $('#ToDate').datepicker({
            uiLibrary: 'bootstrap',
            "dateFormat": "mm/dd/yy"
        });

        $("#MeetingTypeId").select2();
        $("#ParticipantId").select2();
    </script>
}


