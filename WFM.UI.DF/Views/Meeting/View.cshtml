@model WFM.UI.DF.ModelsView.MeetingViewModel
@{
    ViewBag.Title = "Meeting Notes";
}

<script>
    $(document).ready(function () {
        LoadFileNotes();
        LoadMeetingNotes();
        LoadTasks();
    });

    function LoadFileNotes()
    {
        var url = '@Url.Action("DisplayFileNotes", "Meeting")';
        var id = $('#Id').val();
        $('#MeetingFileNotes').load(url, { id: id });
    }
    function LoadMeetingNotes()
    {
        var url = '@Url.Action("DisplayMeetingNotes", "Meeting")';
        var id = $('#Id').val();
        $('#MeetingNotes').load(url, { id: id });
    }
    function LoadTasks()
    {
        var url = '@Url.Action("DisplayTasks", "Meeting")';
        var id = $('#Id').val();
        $('#Tasks').load(url, { id: id });
    }
</script>

@using (Html.BeginForm("SaveOrUpdate", "TaskTracker", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data" }))
{
    <div class="dashboard-ecommerce">
        <div class="container-fluid dashboard-content ">
            @Html.HiddenFor(m => m.Id, new { @name = "Id" })
            <!-- ============================================================== -->
            <!-- pageheader  -->
            <!-- ============================================================== -->
            <div class="row mb-1">
                <div class="col-xl-8 col-lg-8 col-md-11 col-sm-12 col-12">
                    <div class="pagetitle">
                        @ViewBag.Title
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 text-right">
                    @*<button class="cta-sm ml-2 btn btn-sm btn-primary" type="button" fdprocessedid="4w2c8q">In-Progress</button>
                        <button class="cta-sm ml-2 btn btn-sm btn-success" type="button" fdprocessedid="b6qtgf">Completed</button>
                        <button class="cta-sm ml-2 btn btn-sm btn-danger" type="button" fdprocessedid="b6qtgf">Cancel</button>*@
                </div>
            </div>
            <!-- ============================================================== -->
            <!-- end pageheader  -->
            <!-- ============================================================== -->
            <div class="border border-primary bg-actual-white">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-2">
                    <div class="row mb-2 p-2">
                        <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 m-b-10">
                            <label class="control-label"><b>Meeting Type</b></label><br />
                            @Html.TextBoxFor(m => m.MeetingTypeName, new { @class = "form-control", @disabled = "disabled" })
                        </div>
                        <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 m-b-10">
                            <label class="control-label"><b>Name</b></label><br />
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @disabled = "disabled" })
                        </div>
                        <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 m-b-10">
                            <label class="control-label"><b>Location</b></label><br />
                            @Html.TextBoxFor(m => m.Location, new { @class = "form-control", @disabled = "disabled" })
                        </div>
                        <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 m-b-10">
                            <label class="control-label"><b>Internal Participants</b></label><br />
                            @Html.TextAreaFor(m => m.InternalParticipantNames, new { @class = "form-control", @disabled = "disabled" })
                        </div>
                        <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 m-b-10">
                            <label class="control-label"><b>External Participants</b></label><br />
                            @Html.TextAreaFor(m => m.ExternalParticipants, new { @class = "form-control", @disabled = "disabled" })
                        </div>
                        <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 m-b-10">
                            <label class="control-label"><b>KPI's'</b></label><br />
                            @Html.TextAreaFor(m => m.KPI, new { @class = "form-control", @disabled = "disabled" })
                        </div>
                    </div>
                    <hr />
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-2">
                    <div class="row mb-2">                        
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-0">
                            <div id="MeetingNotes">
                            </div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-0">
                            <div id="MeetingFileNotes">
                            </div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-0">
                            <div id="Tasks">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}