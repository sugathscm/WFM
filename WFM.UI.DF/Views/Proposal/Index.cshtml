@{
    ViewBag.Title = "Proposal Pipeline";
}

<script type="text/javascript">
    $(document).ready(function () {
        $('select').select2({
            width: '100%',
            selectOnClose: true
        });

        LoadProposals();

        $('.search').on('click', function () {
            LoadProposals();
        });
    });

    function delayBadge(status) {
        if (status == "OVERDUE")
            return '<span class="badge badge-danger">OVERDUE</span>';
        if (status.indexOf("CRITICAL") == 0)
            return '<span class="badge badge-danger">' + status + '</span>';
        if (status == "AT RISK")
            return '<span class="badge badge-warning">AT RISK</span>';
        if (status == "ON TRACK")
            return '<span class="badge badge-success">ON TRACK</span>';
        return '';
    }

    function outcomeBadge(outcome) {
        if (outcome == "Won")
            return '<span class="badge badge-success">Won</span>';
        if (outcome == "Lost")
            return '<span class="badge badge-danger">Lost</span>';
        if (outcome == "" || outcome == null)
            return '';
        return '<span class="badge badge-info">' + outcome + '</span>';
    }

    function LoadProposals() {
        if ($.fn.DataTable.isDataTable('#List')) {
            $('#List').DataTable().destroy();
        }
        $('#List').DataTable({
            "paging": true,
            "ajax": {
                "url": "/Proposal/GetList",
                "type": "POST",
                "datatype": "json",
                "data": {
                    "StatusId": $("#StatusId").val(),
                    "SectorId": $("#SectorId").val(),
                    "OrganizationId": $("#OrganizationId").val()
                }
            },
            "createdRow": function (row, data, index) {
                $(row).addClass(data["CSSStatusName"]);
            },
            "columns": [
                {
                    "data": "Id", "searchable": false, "ordering": false,
                    "render": function (data, type, full, meta) {
                        return '<a class="btn btn-xs" href="/PublicSectorTender/Details/' + data + '" target="_blank" title="edit"><img src="/assets/images/grid/e.png" width="30" /></a>';
                    }
                },
                { "data": "ProjectCode" },
                { "data": "OrganizationName" },
                { "data": "StatusName" },
                { "data": "SectorName" },
                {
                    "data": "LKRValue", "searchable": false,
                    "render": $.fn.dataTable.render.number(',', '.', 2, ''), className: "dt-body-right"
                },
                { "data": "BidNoBidTotal", "searchable": false },
                { "data": "StartDate", "searchable": false },
                { "data": "Deadline", "searchable": false },
                { "data": "DaysLeft", "searchable": false },
                { "data": "GatesDone", "searchable": false },
                {
                    "data": "GateControlPercentComplete", "searchable": false,
                    "render": function (data) { return (data == null) ? '' : data + '%'; }
                },
                { "data": "QAScoreTotal", "searchable": false },
                {
                    "data": "DelayStatus", "searchable": false,
                    "render": function (data) { return delayBadge(data); }
                },
                { "data": "GateControlCurrentStage" },
                {
                    "data": "Outcome", "searchable": false,
                    "render": function (data) { return outcomeBadge(data); }
                },
                { "data": "ReasonForLoss" },
                { "data": "OwnerName" }
            ]
        });
    }
</script>

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content ">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="page-header">
                    <h2 class="pageheader-title">@ViewBag.Title</h2>
                </div>
            </div>
        </div>
        <div class="border border-primary bg-actual-white">
            <div class="row col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-b-10 m-t-10">
                <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12 mb-0">
                    <div class="form-group row">
                        <label class="col-12 col-sm-12 col-form-label text-small">Status</label>
                        <div class="col-lg-12 col-md-12 col-sm-12">
                            @Html.DropDownList("StatusId", new SelectList(ViewBag.StatusList, "Id", "Name"), "All Statuses", new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12 mb-0">
                    <div class="form-group row">
                        <label class="col-12 col-sm-12 col-form-label text-small">Sector</label>
                        <div class="col-lg-12 col-md-12 col-sm-12">
                            @Html.DropDownList("SectorId", new SelectList(ViewBag.SectorList, "Id", "Name"), "All Sectors", new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 mb-0">
                    <div class="form-group row">
                        <label class="col-12 col-sm-12 col-form-label text-small">Organization</label>
                        <div class="col-lg-12 col-md-12 col-sm-12">
                            @Html.DropDownList("OrganizationId", new SelectList(ViewBag.OrganizationList, "Id", "Name"), "All Organizations", new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-xl-1 col-lg-1 col-md-12 col-sm-12 col-12 mb-2">
                    <div class="form-group row">
                        <label class="col-lg-12 col-sm-12 col-form-label text-small">&nbsp;</label>
                        <div class="col-lg-12 col-sm-12">
                            <button class="cta-sm ml-2 btn btn-sm search btn-success" type="button">Search</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table id="List" class="table table-striped table-bordered first">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th style="width:5%">Ref</th>
                                            <th style="width:15%">Client / donor</th>
                                            <th>Status</th>
                                            <th>Sector</th>
                                            <th>Value (LKR)</th>
                                            <th>Bid score</th>
                                            <th>Start</th>
                                            <th>Deadline</th>
                                            <th>Days left</th>
                                            <th>Gates done</th>
                                            <th>% complete</th>
                                            <th>QA score</th>
                                            <th>Delay status</th>
                                            <th>Stage</th>
                                            <th>Outcome</th>
                                            <th>Reason</th>
                                            <th>Owner</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
