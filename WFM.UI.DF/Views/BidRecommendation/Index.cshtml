@{
    ViewBag.Title = "Bid Recommendation List";
}

<script type="text/javascript">
    $(document).ready(function () {
        $('#List').DataTable({
            "paging": true,
            "ajax": {
                "url": "/BidRecommendation/GetList",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                {
                    "data": "ProjectId", "searchable": false, "ordering": false,
                    "render": function (data, type, full, meta) {
                        return '<a href="/PublicSectorTender/Details/' + data + '">' + full.ProjectCode + '</a>';
                    }
                },
                { "data": "ProjectName" },
                { "data": "ConsortiumJV" },
                { "data": "Source" },
                { "data": "StrategicFit" },
                {
                    "data": "Eligible",
                    "render": function (data) {
                        if (data === true)
                            return '<span class="text-success">Yes</span>';
                        else if (data === false)
                            return '<span class="text-danger">No</span>';
                        else
                            return '';
                    }
                },
                {
                    "data": "RecommendStatusName",
                    "render": function (data) {
                        if (data == "Proceed to Bid")
                            return '<span class="badge badge-success">' + data + '</span>';
                        else if (data == "Decline")
                            return '<span class="badge badge-danger">' + data + '</span>';
                        else
                            return data;
                    }
                },
            ]
        });
    });
</script>

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content ">
        <!-- ============================================================== -->
        <!-- pageheader  -->
        <!-- ============================================================== -->
        @Html.Partial("_PageHeaderPartial")
        <!-- ============================================================== -->
        <!-- end pageheader  -->
        <!-- ============================================================== -->
        <div class="border border-primary bg-actual-white">
            <div class="row col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-b-10">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-t-20">
                    <div class="table-responsive">
                        <table id="List" class="table table-striped table-bordered first">
                            <thead>
                                <tr>
                                    <th>Ref</th>
                                    <th>Opportunity</th>
                                    <th>Consortium / JV</th>
                                    <th>Source</th>
                                    <th>Strategic Fit</th>
                                    <th>Eligible?</th>
                                    <th>Recommend</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
