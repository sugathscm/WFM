@model WFM.UI.DF.ModelsView.ManagementDashboardViewModel
@{
    ViewBag.Title = "Dashboard";
}

<script src="~/Scripts/chart.min.js"></script>
<style>
.kpi-card{
    display:block;
    background:#fff;
    border:1px solid #ddd;
    border-radius:10px;
    padding:14px;
    color:inherit;
    text-decoration:none;
}
.kpi-card:hover{
    border-color:#adb5bd;
    color:inherit;
    text-decoration:none;
}
.kpi-label{
    font-size:12px;
    color:#68727d;
}
.kpi-value{
    font-size:24px;
    font-weight:600;
    margin-top:4px;
}
.kpi-card.danger{
    background:#fff0f0;
    border-color:#f3d0d0;
}
.kpi-card.danger .kpi-label,
.kpi-card.danger .kpi-value{
    color:#c0392b;
}
.panel{
    background:#fff;
    border:1px solid #ddd;
    border-radius:10px;
    padding:16px;
}
.panel-title{
    font-size:13px;
    color:#68727d;
    margin-bottom:10px;
}
.risk-row{
    display:flex;
    justify-content:space-between;
    font-size:13px;
    padding:8px 0;
    border-bottom:1px solid #eee;
    color:inherit;
    text-decoration:none;
}
.risk-row:hover{
    background:#f7f9fb;
    color:inherit;
    text-decoration:none;
}
.risk-row:last-child{border-bottom:none}
.risk-row .badge-danger{background:#e24b4a}
.risk-row .badge-warning{background:#e58b00}
</style>

<script type="text/javascript">
    $(document).ready(function () {
        $('select').select2({
            width: '100%',
            selectOnClose: true
        });

        $('.search').on('click', function () {
            LoadTasks();
        });

        LoadTasks();

        $('#List').on('click', '.updates', function () {
            var $row = $(this).closest('tr');
            var rowData = table.row($row).data();
            var id = rowData["Id"];

            var route = '@Url.Action("Update", "TaskTracker")/' + id;
            console.log(route);

            $('#viewpartial').load(route);
            $('#UpdatesModal').modal('show');
        });

        $('#List').on('click', '.documents', function () {
            var $row = $(this).closest('tr');
            var rowData = table.row($row).data();
            var id = rowData["Id"];

            var route = '@Url.Action("Documents", "TaskTracker")/' + id;
            console.log(route);

            $('#viewpartial').load(route);
            $('#DocumentsModal').modal('show');
        });
    });

    function LoadTasks() {
        $('#List').DataTable().destroy();
        table = $('#List').DataTable({
            "paging": true,

            "ajax": {
                "url": "/Home/GetList",
                "type": "POST",
                "datatype": "json",
                "data": {
                    "StatusId": $("#StatusId").val(),
                    "ProjectId": $("#ProjectId").val(),
                    "MeetingId": $("#MeetingId").val(),
                    "TaskTypeId": $("#TaskTypeId").val(),
                    "AssigneeId": $("#AssigneeId").val(),
                    "PriorityId": $("#PriorityId").val(),
                }
            },
            "createdRow": function (row, data, index) {
                $(row).addClass(data["ST"]);
            },
            order: [[0, 'desc']],
            "columns": [
                { "data": "Id" },
                { "data": "strCreatedDate" },
                { "data": "Priority" },
                { "data": "TaskCategory" },
                { "data": "TaskDescription" },
                { "data": "CurrentProgressNote" },
              /*  { "data": "strDueDate" },*/
                { "data": "DR" },
                {
                    "data": "Id", "searchable": false, "ordering": false,
                    "render": function (data, type, full, meta) {
                        return '<a target="_blank" title="view"  class="btn btn-xs" href="/TaskTracker/View/' + data + '"><img src = "/assets/images/grid/s.png" width="30" /></a>';
                    }
                },
                {
                    "data": "Id", "searchable": false, "ordering": false,

                    "render": function (data, type, full, meta) {
                        if (full["StatusId"] != 3)
                            return '@if (User.IsInRole("Administrator") || User.IsInRole("Editor")) {<a title="edit" class="btn btn-xs" href="/TaskTracker/Details/' + data + '"><img src = "/assets/images/grid/e.png" width="30" /></a>}';
                        else
                            return '';
                    }
                },
            ]
        });
    }
</script>

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content ">
        <div class="row mb-1">
            <div class="col-xl-10 col-lg-10 col-md-12 col-sm-12 col-12">
                <div class="pagetitle">
                    <h3>@ViewBag.Title</h3>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xl-8 col-lg-8 col-md-12 col-sm-12 col-12 pull-right">
                @if (TempData["Message"] != null)
                {
                    @Html.Raw(TempData["Message"])
                }
            </div>
        </div>
        <input type="hidden" id="EmployeeId" value="@ViewBag.EmployeeId" />
        <div class="border border-primary bg-actual-white p-3">
            <div class="row">
                <div class="col-6 col-md-2 mb-3">
                    <a class="kpi-card" href="@Url.Action("Index", "Opportunity")" target="_blank" title="View opportunity list">
                        <div class="kpi-label">Active opportunities</div>
                        <div class="kpi-value">@Model.ActiveOpportunities</div>
                    </a>
                </div>
                <div class="col-6 col-md-2 mb-3">
                    <a class="kpi-card" href="@Url.Action("Index", "Proposal")" target="_blank" title="View proposal pipeline">
                        <div class="kpi-label">Active proposals</div>
                        <div class="kpi-value">@Model.ActiveProposals</div>
                    </a>
                </div>
                <div class="col-6 col-md-2 mb-3">
                    <a class="kpi-card" href="@Url.Action("Index", "WinLossDashboard")" target="_blank" title="View win/loss dashboard">
                        <div class="kpi-label">Win rate (90d)</div>
                        <div class="kpi-value">@(Model.WinRate90d == null ? "-" : Model.WinRate90d + "%")</div>
                    </a>
                </div>
                <div class="col-6 col-md-2 mb-3">
                    <a class="kpi-card" href="@Url.Action("Index", "Proposal")" target="_blank" title="View proposal pipeline">
                        <div class="kpi-label">Ongoing projects</div>
                        <div class="kpi-value">@Model.OngoingProjects</div>
                    </a>
                </div>
                <div class="col-6 col-md-2 mb-3">
                    <a class="kpi-card @(Model.OverdueCount > 0 ? "danger" : "")" href="#risk-panel" title="Jump to risk and bottlenecks">
                        <div class="kpi-label">Overdue items</div>
                        <div class="kpi-value">@Model.OverdueCount</div>
                    </a>
                </div>
                <div class="col-6 col-md-2 mb-3">
                    <a class="kpi-card" href="@Url.Action("Index", "BidNoBid")" target="_blank" title="View Bid/No-Bid list">
                        <div class="kpi-label">Avg bid score (GO)</div>
                        <div class="kpi-value">@(Model.AvgBidScore == null ? "-" : Model.AvgBidScore.ToString())</div>
                    </a>
                </div>
            </div>

            <div class="row">
                <div class="col-md-7 mb-3">
                    <div class="panel">
                        <div class="panel-title">Pipeline funnel</div>
                        <div style="position:relative;height:220px;">
                            <canvas id="funnelChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-md-5 mb-3">
                    <div class="panel">
                        <div class="panel-title">Delivery health (ongoing projects)</div>
                        <div style="position:relative;height:220px;">
                            <canvas id="healthChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="panel mb-3" id="risk-panel">
                        <div class="panel-title">Risk and bottlenecks</div>
                        @if (Model.Risks == null || Model.Risks.Count == 0)
                        {
                            <div class="text-muted" style="font-size:13px;">Nothing needs attention right now.</div>
                        }
                        else
                        {
                            foreach (var r in Model.Risks)
                            {
                                <a class="risk-row" href="@Url.Action("Details", "PublicSectorTender", new { id = r.ProjectId })" target="_blank" title="Open project">
                                    <span>@r.ProjectName</span>
                                    <span class="badge @(r.Severity == "danger" ? "badge-danger" : "badge-warning")">@r.Issue</span>
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

<script>
    $(document).ready(function () {
        var funnelLinks = [
            '@Url.Action("Index", "Opportunity")',
            '@Url.Action("Index", "BidNoBid")',
            '@Url.Action("Index", "Proposal")',
            '@Url.Action("Index", "Proposal")',
            '@Url.Action("Index", "WinLossDashboard")'
        ];

        var funnelChartEl = document.getElementById('funnelChart');
        funnelChartEl.style.cursor = 'pointer';
        new Chart(funnelChartEl.getContext('2d'), {
            type: 'bar',
            data: {
                labels: ['Opportunity', 'GO decision', 'Proposal', 'Shortlisted', 'Won'],
                datasets: [{
                    data: [@Model.FunnelOpportunity, @Model.FunnelGoDecision, @Model.FunnelProposal, @Model.FunnelShortlisted, @Model.FunnelWon],
                    backgroundColor: '#378ADD'
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { x: { beginAtZero: true, ticks: { precision: 0 } } },
                onClick: function (evt, elements) {
                    if (elements.length > 0) {
                        window.open(funnelLinks[elements[0].index], '_blank');
                    }
                }
            }
        });

        var healthChartEl = document.getElementById('healthChart');
        healthChartEl.style.cursor = 'pointer';
        new Chart(healthChartEl.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: ['On track', 'Attention', 'Delayed'],
                datasets: [{
                    data: [@Model.HealthOnTrack, @Model.HealthAttention, @Model.HealthDelayed],
                    backgroundColor: ['#16a36c', '#e58b00', '#e24b4a'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: { legend: { position: 'bottom' } },
                onClick: function (evt, elements) {
                    if (elements.length > 0) {
                        window.open('@Url.Action("Index", "Proposal")', '_blank');
                    }
                }
            }
        });
    });
</script>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script>
    $(document).ready(function () {
        $('#AssigneeId').select2().val($('#EmployeeId').val());
        $("#AssigneeId").select2().trigger('change');
        if ($.isNumeric($('#EmployeeId').val())) {
            $("#AssigneeId").select2("enable", true);
        }
        else {
            $("#AssigneeId").select2("enable", false);
        }
    });
</script>
