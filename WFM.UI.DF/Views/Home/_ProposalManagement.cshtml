<section class="card">
    <div class="card-header">
        <h2>Proposal Management</h2>
        <div class="menu">•••</div>
    </div>

    <div class="section-title">Bid to Award Pipeline</div>

    <div class="pipeline">
        <div class="pipe">
            <strong>12</strong>
            <small>EOI submitted</small>
        </div>
        <div class="pipe">
            <strong>7</strong>
            <small>Shortlisted (EOI win)</small>
        </div>
        <div class="pipe">
            <strong>9</strong>
            <small>RFP stage</small>
        </div>
        <div class="pipe">
            <strong style="color:#159b68">4</strong>
            <small>Awarded → Project</small>
        </div>
    </div>

    <div class="section-title">
        Submitted and Ongoing Proposals Tracking
    </div>

    <div class="track-labels">
        <span>Submitted (7)</span>
        <span>57% win</span>
        <span>Ongoing (5)</span>
        <span>In prep</span>
    </div>

    <div class="track-bar">
        <span class="won" style="width:28%">4 won</span>
        <span class="lost" style="width:28%">3 lost</span>
        <span class="rfi" style="width:20%">2 RFI</span>
        <span class="rfp" style="width:24%">3 RFP</span>
    </div>

    <div class="section-title">Proposal risk factors</div>

    <div class="risks">

        <div class="risk">
            <div class="risk-icon purple">◉</div>
            <div>
                <div class="risk-title">Lack of Expert Team</div>
                <div class="risk-desc">Both - No qualified expert mapped to a required position</div>
                <div class="risk-line"><span class="purple-line" style="width:85%"></span></div>
            </div>
            <div class="risk-score" style="color:#824ce8">4</div>
        </div>

        <div class="risk">
            <div class="risk-icon orange">◉</div>
            <div>
                <div class="risk-title">Methodology Submission Delay</div>
                <div class="risk-desc">Ongoing - Methodology document still in draft / missing past plan</div>
                <div class="risk-line"><span class="orange-line" style="width:65%"></span></div>
            </div>
            <div class="risk-score" style="color:#df8a00">4</div>
        </div>

        <div class="risk">
            <div class="risk-icon red">◉</div>
            <div>
                <div class="risk-title">Financial Proposal Weakness</div>
                <div class="risk-desc">Submitted - Pricing scored low / uncompetitive vs winners</div>
                <div class="risk-line"><span class="red-line" style="width:45%"></span></div>
            </div>
            <div class="risk-score" style="color:#df4545">2</div>
        </div>

        <div class="risk">
            <div class="risk-icon blue">◉</div>
            <div>
                <div class="risk-title">Technical Proposal Weakness</div>
                <div class="risk-desc">Submitted - Technical score below qualification threshold</div>
                <div class="risk-line"><span class="blue-line" style="width:30%"></span></div>
            </div>
            <div class="risk-score" style="color:#1298bd">1</div>
        </div>

    </div>
</section>

