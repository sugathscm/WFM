@using WFM.BAL.ViewModels;

@{
    ViewBag.Title = "Opportunity List";
}
<script src="//datatables.net/download/build/nightly/jquery.dataTables.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        var table = $('#example').DataTable();
        $('select').select2({
            width: '100%',
            selectOnClose: true
        });

        LoadProjects();

        $('.search').on('click', function () {
            LoadProjects();
        });
    });

    function LoadProjects() {
        $('#List').DataTable().destroy();
        table = $('#List').DataTable({
            "paging": true,

            "ajax": {
                "url": "/Opportunity/GetList",
                "type": "POST",
                "datatype": "json",
                "data": {
                    "StatusId": $("#StatusId").val(),
                    "TypeId": $("#TypeId").val(),
                    "SectorId": $("#SectorId").val(),
                    "OrganizationId": $("#OrganizationId").val(),
                    "StageId": $("#StageId").val(),
                }
            },
            "createdRow": function (row, data, index) {
                $(row).addClass(data["CSSStatusName"]);
                $(row).addClass(data["CSSDR"]);
            },
            order: [[2, 'desc']],
            "columns": [
                {
                    "data": "Id", "searchable": false, "ordering": false,
                    "render": function (data, type, full, meta) {
                        return '@if (User.IsInRole("Administrator") || User.IsInRole("Editor")) {<a class="btn btn-xs" href="Details/' + data + '" target="_blank" title="edit"><img src="/assets/images/grid/e.png" width="30" /></a>}'
                    }
                },
                {
                    "data": "Id", "searchable": false, "ordering": false,
                    "render": function (data, type, full, meta) {
                        return '<a class="btn btn-xs" href="../PublicSectorTender/Details/' + data + '" target="_blank" title="edit"><img src="/assets/images/grid/s.png" width="30" /></a>'
                    }
                },
                { "data": "ProjectCode" },
                { "data": "OrganizationName" },
                { "data": "TypeName" },
                { "data": "SectorName" },
                {
                    "data": "LKRValue",
                    "render": $.fn.dataTable.render.number(',', '.', 2, ''), className: "dt-body-right"
                },
                { "data": "strDates" },
                { "data": "Comment" },
                // { "data": "SE" },
                {
                    "data": "BidNoBidDecision", "searchable": false,
                    "render": function (data, type, full, meta) {
                        var badgeClass = (data == "GO") ? "badge-success" : (data == "NO-BID / REVIEW") ? "badge-danger" : "";
                        if (data == "" || data == null)
                            return '';
                        return '<span class="badge ' + badgeClass + '">' + data + '</span> (' + full.BidNoBidTotal + ')';
                    }
                },
                {
                    "data": "QAScoreDecision", "searchable": false,
                    "render": function (data, type, full, meta) {
                        var badgeClass = (data == "GO") ? "badge-success" : (data == "REVIEW") ? "badge-danger" : "";
                        if (data == "" || data == null)
                            return '';
                        return '<span class="badge ' + badgeClass + '">' + data + '</span> (' + full.QAScoreTotal + ')';
                    }
                },
                {
                    "data": "GateControlCurrentStage", "searchable": false,
                    "render": function (data) {
                        return (data == null) ? '' : data;
                    }
                },
                {
                    "data": "RecommendStatusName", "searchable": false,
                    "render": function (data) {
                        if (data == "Proceed to Bid")
                            return '<span class="badge badge-success">' + data + '</span>';
                        else if (data == "Decline")
                            return '<span class="badge badge-danger">' + data + '</span>';
                        else
                            return (data == null) ? '' : data;
                    }
                },
            ]
        });

    }
</script>

