                        <label class="col-12 col-sm-12 col-form-label text-small">Type</label>
                        <div class="col-lg-12 col-md-12 col-sm-12">
                            @Html.DropDownList("TypeId", new SelectList(ViewBag.ProjectTypeFullList, "Id", "Name"), "All Types", new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-12 col-sm-12 col-12 mb-0">
                    <div class="form-group row">
                        <label class="col-12 col-sm-12 col-form-label text-small">Status</label>
                        <div class="col-lg-12 col-md-12 col-sm-12">
