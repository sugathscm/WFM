@model WFM.DAL.WFM_MeetingType

@{
    ViewBag.Title = "Meeting Type Management";
}

<script type="text/javascript">
    $(document).ready(function () {
        $('#List').DataTable({
            "paging": true,
            "ajax": {
                "url": "/MeetingType/GetList",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "Topic" },
                { "data": "Location" },
                {
                    "data": "Id", "searchable": false, "ordering": false,
                    "render": function (data, type, full, meta) {
                        return '<a class="btn btn-info" href="/Meeting/Index/' + data + '">Edit</a>';
                    }
                },
            ]
        });
    });
</script>

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content ">
        <!-- ============================================================== -->
        <!-- pageheader  -->
        <!-- ============================================================== -->
        @Html.Partial("_PageHeaderPartial")
        <!-- ============================================================== -->
        <!-- end pageheader  -->
        <!-- ============================================================== -->
        <div class="border border-primary bg-actual-white">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-b-10">
                @using (Html.BeginForm("SaveOrUpdate", "MeetingType", FormMethod.Post, new { @class = "needs-validation", role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary("", new { @class = "text-danger" })
                    @Html.HiddenFor(m => m.Id, new { @name = "Id" })
                    <div class="form-row">
                        <div class="col-xl-5 col-lg-5 col-md-12 col-sm-12 col-12 mb-2">
                            @Html.LabelFor(m => m.Topic, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.Topic, new { @class = "form-control" })
                        </div>
                        <div class="col-xl-4 col-lg-8 col-md-12 col-sm-12 col-12 mb-2">
                            @Html.LabelFor(m => m.Location, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.Location, new { @class = "form-control" })
                        </div>              
                        @*<div class="col-xl-2 col-lg-2 col-md-12 col-sm-12 col-12 mb-2">
                            @Html.LabelFor(m => m.Date, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.Date, new { @class = "form-control" })
                        </div>*@
                        <div class="col-xl-1 col-lg-1 col-md-12 col-sm-12 col-12 ">
                            <label>&nbsp;</label><br />
                            <input type="submit" class="btn btn-xs btn-success" value="Save" />
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="border border-primary bg-actual-white m-b-10 m-t-10">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-b-10 m-t-10">
                <div class="table-responsive">
                    <table id="List" class="table table-striped table-bordered first">
                        <thead>
                            <tr>
                                @*<th>Date</th>*@
                                <th>Topic</th>
                                <th>Location</th>
                                <th></th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $('#Date').datepicker({
            uiLibrary: 'bootstrap',
            "dateFormat": "mm/dd/yy"
        });
    </script>
}


