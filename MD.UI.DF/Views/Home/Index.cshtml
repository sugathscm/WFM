@model WFM.UI.DF.ModelsView.TaskTrackerViewModel
@{
    ViewBag.Title = "Ministry List";
}

<script type="text/javascript">
    $(document).ready(function () {
        $('select').select2({
            width: '100%',
            selectOnClose: true
        });

        $('.search').on('click', function () {
            LoadTasks();
        });

        LoadMinistries();

        $('#List').on('click', '.updates', function () {
            var $row = $(this).closest('tr');
            var rowData = table.row($row).data();
            var id = rowData["Id"];

            var route = '@Url.Action("Update", "TaskTracker")/' + id;
            console.log(route);

            $('#viewpartial').load(route);
            $('#UpdatesModal').modal('show');
        });

        $('#List').on('click', '.documents', function () {
            var $row = $(this).closest('tr');
            var rowData = table.row($row).data();
            var id = rowData["Id"];

            var route = '@Url.Action("Documents", "TaskTracker")/' + id;
            console.log(route);

            $('#viewpartial').load(route);
            $('#DocumentsModal').modal('show');
        });
    });

    function LoadMinistries() {
        $('#List').DataTable().destroy();
        table = $('#List').DataTable({
            "paging": true,
            "scrollX": false,
            "order": [
                [0, 'asc']
            ],
            "ajax": {
                "url": "/Ministry/GetList",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "Id" },
                {
                    "data": "Id", "className": "dt-center", "targets": "_all",
                    "render": function (data, type, full, meta) {
                        return '<a style="width: 200px" target="_blank" href="/Ministry/View/' + data +'"><b>' + full["Name"] + "</b></a>" 
                            + '<br /><br />'
                            + '<a href=' + full["Web"] + ' target="_blank"><img src="/Images/www.png" alt="" width="20" /></a>&nbsp;&nbsp;'
                            + '<a href=' + full["GeoLocation"] + ' target="_blank"><img src="/Images/map.png" alt="" width="13" /></a>';
                    }
                },
                {
                    "data": "MinisterId", "className": "dt-center", "targets": "_all",
                    "render": function (data, type, full, meta) {
                        return '<img src="/Images/Member/' + data + '.png" width="90" height="90"/></a><br />' + full["Minister"] + '<br />' + full["MinisterProfiles"] + '<br /><i class="related">' + full["MinisterRelated"] + '</i>';
                    }
                },
                {
                    "data": "DeputyMinisterId", "className": "dt-center", "targets": "_all",
                    "render": function (data, type, full, meta) {
                        if (data != null)
                            return '<img src="/Images/Member/' + data + '.png" width="90" height="90" /></a><br />' + full["DeputyMinister"] + '<br />' + full["DeputyMinisterProfiles"] + '<br /><i class="related">' + full["DeputyMinisterRelated"] + '</i>';
                        else
                            return '';
                    }
                },
                {
                    "data": "MinistrySecrateryId", "className": "dt-center", "targets": "_all",
                    "render": function (data, type, full, meta) {
                        if (data != null)
                            return '<img src="/Images/Member/' + data + '.png" width="90" height="90"/></a><br />' + full["MinistrySecratery"] + '<br />' + full["MinistrySecrateryProfiles"] + '<br /><i class="related">' + full["MinistrySecrateryRelated"] + '</i>';
                        else
                            return '';
                    }
                },
            ]
        });
    }
</script>

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content ">
        <div class="row mb-2 mt-2">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            </div>
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12" style="padding: 0 0">
                <div class="table-responsive">
                    <table id="List" class="table table-striped table-bordered first">
                        <thead>
                            <tr>
                                <th style="width:1%">#</th>
                                <th style="width: 200px;word-wrap:break-word">Ministry</th>
                                <th style="width: 25%; word-wrap: normal">Minister</th>
                                <th style="width: 25%; word-wrap: normal">Deputy Minister</th>
                                <th style="width: 25%; word-wrap: normal">Ministry Secratery</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
