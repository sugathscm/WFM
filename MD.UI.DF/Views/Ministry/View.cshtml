@model WFM.DAL.GetMinistries_Result
@{
    ViewBag.Title = "Ministry List";
}

<div class="row mt-2">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <table class="table table-striped table-bordered first">
            <tr>
                <th class="text-center">
                    <h4>@Model.Name</h4>
                </th>
            </tr>
            <tr>
                <td class="text-justify">
                    <h6>Scope</h6>
                    <span>@Html.Raw(HttpUtility.HtmlDecode(Model.Scope))</span>
                </td>
            </tr>
            <tr>
                <td class="text-justify">
                    <h6>Description</h6>
                    <span>@Html.Raw(HttpUtility.HtmlDecode(Model.Description))</span>
                </td>
            </tr>
        </table>
    </div>
</div>

<div class="row">
    <div class="col-xl-1 col-lg-1 col-md-12 col-sm-12 col-12">
    </div>
    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 m-2 text-center">
        <div class="form-group row">
            <div class="col-lg-12 col-md-12 col-sm-12 text-center border-blue bg-yellow">
                <h6>Minister</h6>
                <img src="~/Images/Member/@(String.Format("{0}.{1}", Model.MinisterId, "png"))" width="100" height="100" />
                <h6 class="text-blue">@Html.Raw(HttpUtility.HtmlEncode(Html.DisplayFor(m => m.Minister)))</h6>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 m-2 text-center">
        <div class="form-group row">
            <div class="col-lg-12 col-md-12 col-sm-12 text-center border-blue bg-yellow">
                <h6>Deputy Minister</h6>
                <img src="~/Images/Member/@(String.Format("{0}.{1}", Model.DeputyMinisterId, "png"))" width="100" height="100" />
                <h6 class="text-blue">
                    @Html.Raw(HttpUtility.HtmlDecode(Html.DisplayFor(m => m.DeputyMinister).ToString()))
                </h6>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 m-2 text-center">
        <div class="form-group row">
            <div class="col-lg-12 col-md-12 col-sm-12 text-center border-blue bg-yellow">
                <h6>Ministry Secratery</h6>
                <img src="~/Images/Member/@(String.Format("{0}.{1}", Model.MinistrySecrateryId, "png"))" width="100" height="100" />
                <h6 class="text-blue">@Html.Raw(HttpUtility.HtmlEncode(Html.DisplayFor(m => m.MinistrySecratery)))</h6>
            </div>
        </div>
    </div>
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mt-3" style="padding: 0 0">
        <div class="table-responsive">
            <table id="List" class="table table-striped table-bordered first">
                <thead>
                    <tr>
                        <th style="width:1%">#</th>
                        <th style="width: 33%; word-wrap: normal">Agency Name</th>
                        <th style="width: 33%; word-wrap: normal">Chairman of the Departments or Institutes</th>
                        <th style="width: 33%; word-wrap: normal">Officials of the Departments and Institutes </th>
                    </tr>
                    @{int i = 0; }
                    @foreach (var agency in ViewBag.LineAgencies)
                    {
                        i = i + 1;

                        <tr>
                            <td style="width:1%">@i</td>
                            <td style="width: 33%; word-wrap: normal">@agency.Name</td>
                            <td style="width: 33%; word-wrap: normal">@agency.MemberName<br />@agency.MemberProfiles</td>
                            <td style="width: 33%; word-wrap: normal">@agency.DesignationName</td>
                        </tr>
                    }
                </thead>
            </table>
        </div>
    </div>
</div>

