@model WFM.DAL.MD_Member
@{
    Layout = "../Shared/_LayoutAdministration.cshtml";
    ViewBag.Title = "Member";
}

<script type="text/javascript">
    $(document).ready(function () {
        $('#List').DataTable({
            "paging": true,

            "ajax": {
                "url": "/Member/GetList",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "Name" },
                {
                    "data": "IsActive",
                    "render": function (data, type, full, meta) {
                        if (data == "1")
                            return 'Yes';
                        else
                            return 'No';
                    }
                },
                {
                    "data": "Id", "searchable": false, "ordering": false,
                    "render": function (data, type, full, meta) {
                        return '<a class="btn btn-info" href="/Member/Index/' + data + '">Edit</a>';
                    }
                },
            ]
        });
    });
</script>

<div class="dashboard-ecommerce">
    <div class="container-fluid dashboard-content">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            @using (Html.BeginForm("SaveOrUpdate", "Member", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "text-danger" })
                <div class="row mb-3">
                    @Html.HiddenFor(m => m.Id, new { @name = "Id" })
                    @Html.LabelFor(m => m.Name, new { @class = "col-md-1 control-label" })
                    <div class="col-md-3">
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    </div>
                    <div class="col-md-2">
                        <input type="submit" class="btn btn-primary" value="Save" />
                    </div>
                </div>
            }
        </div>
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-t-20">
            <div class="table-responsive">
                <table id="List" class="table table-striped table-bordered first">
                    <thead>
                        <tr>
                            <th style="width:100%">Name</th>
                            <th>Active</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>