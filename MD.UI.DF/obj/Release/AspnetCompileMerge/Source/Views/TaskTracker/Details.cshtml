@model WFM.UI.DF.ModelsView.TaskTrackerViewModel

@{
    ViewBag.Title = "Task ";
}

@using (Html.BeginForm("SaveOrUpdate", "TaskTracker", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    <div class="dashboard-ecommerce">
        <div class="container-fluid dashboard-content ">
            <!-- ============================================================== -->
            <!-- pageheader  -->
            <!-- ============================================================== -->
            <div class="row">
                <div class="col-xl-11 col-lg-11 col-md-11 col-sm-12 col-12">
                    <div class="page-header">
                        @if (Model == null)
                        {
                            <h2 class="pageheader-title">New/Edit @ViewBag.Title </h2>
                        }
                    </div>
                </div>
                <div class="col-xl-1 col-lg-1 col-md-1 col-sm-12 col-12 text-right">
                    <button type="button" class="btn btn-success float-left">Completed</button>
                </div>
                <div class="col-xl-1 col-lg-1 col-md-1 col-sm-12 col-12 text-right">
                    <button type="button" class="btn btn-warning float-left">Cancel</button>
                </div>
            </div>
            <!-- ============================================================== -->
            <!-- end pageheader  -->
            <!-- ============================================================== -->
            <div class="border border-primary bg-actual-white">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 m-b-10">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary("", new { @class = "text-danger" })
                    @Html.HiddenFor(m => m.Id, new { @name = "Id" })
                    <div class="row">
                        <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-12 col-sm-12 col-form-label text-small">Task Type</label>
                                <div class="col-lg-12 col-md-12 col-sm-12">
                                    @Html.DropDownListFor(m => m.TaskTypeId, new SelectList(ViewBag.TaskTypeList, "Id", "Name"), "Select Task Type", new { @class = "form-select" })
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-12 col-sm-12 col-form-label text-small">Project</label>
                                <div class="col-lg-12 col-md-12 col-sm-12">
                                    @Html.DropDownListFor(m => m.ProjectId, new SelectList(ViewBag.ProjectList, "Id", "Name"), "No Related Project", new { @class = "form-select" })
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-12 col-sm-12 col-form-label text-small">Meeting</label>
                                <div class="col-lg-12 col-md-12 col-sm-12">
                                    @Html.DropDownListFor(m => m.MeetingId, new SelectList(ViewBag.MeetingList, "Id", "Name"), "No Related Meeting", new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-lg-12 col-sm-12 col-form-label text-small">Priority</label>
                                <div class="col-lg-12 col-sm-12">
                                    @Html.DropDownListFor(m => m.PriorityId, new SelectList(ViewBag.PriorityList, "Id", "Name"), "Select Priority", new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-lg-12 col-sm-12 col-form-label text-small">Add to Agenda</label>
                                <div class="col-lg-12 col-sm-12">
                                    @Html.CheckBoxFor(m => m.AddToAgenda.Value, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        @*<div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 mb-0">
                                <div class="form-group row">
                                    <label class="col-12 col-sm-12 col-form-label text-small">Date of Meeting</label>
                                    <div class="col-lg-12 col-md-12 col-sm-12">
                                        @Html.TextBoxFor(m => m.DateOfMeeting, new { @class = "form-control", @placeholder = "MM/DD/YYYY" })
                                    </div>
                                </div>
                            </div>*@
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-12 col-sm-12 col-form-label text-small">Task Description</label>
                                <div class="col-lg-12 col-md-12 col-sm-12">
                                    @Html.TextBoxFor(m => m.TaskDescription, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-12 col-lg-12 col-md-6 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-lg-12 col-sm-12 col-form-label text-small">Current Progress Note</label>
                                <div class="col-lg-12 col-sm-12">
                                    @Html.TextAreaFor(m => m.CurrentProgressNote, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-12 col-lg-12 col-md-6 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-lg-12 col-sm-12 col-form-label text-small">Comment</label>
                                <div class="col-lg-12 col-sm-12">
                                    @Html.TextAreaFor(m => m.CurrentProgressNote, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-lg-12 col-sm-12 col-form-label text-small">Under the Authority of</label>
                                <div class="col-lg-12 col-sm-12">
                                    @Html.DropDownListFor(m => m.AuthorityId, new SelectList(ViewBag.EmployeeList, "Id", "Name"), "Select Authority", new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-lg-12 col-sm-12 col-form-label text-small">Assignee</label>
                                <div class="col-lg-12 col-sm-12">
                                    @Html.DropDownListFor(m => m.AssigneeId, new SelectList(ViewBag.EmployeeList, "Id", "Name"), "Select Assignee", new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-lg-12 col-sm-12 col-form-label text-small">Date of Assignment</label>
                                <div class="col-lg-12 col-sm-12">
                                    @Html.TextBoxFor(m => m.DateOfAssignment, new { @class = "form-control", @placeholder = "MM/DD/YYYY" })
                                </div>
                            </div>
                        </div>
                        @*<div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 mb-0">
                                <div class="form-group row">
                                    <label class="col-lg-12 col-sm-12 col-form-label text-small">
                                        Taken Next due date
                                    </label>
                                    <div class="col-lg-12 col-sm-12">
                                        @Html.TextBoxFor(m => m.TakenNextDueDate, new { @class = "form-control", @placeholder = "MM/DD/YYYY" })
                                    </div>
                                </div>
                            </div>*@
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-lg-12 col-sm-12 col-form-label text-small">Due Date</label>
                                <div class="col-lg-12 col-sm-12 ">
                                    @Html.TextBoxFor(m => m.DueDate, new { @class = "form-control", @placeholder = "MM/DD/YYYY" })
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-12 col-sm-12 col-form-label text-small">Email to</label>
                                <div class="col-lg-12 col-md-12 col-sm-12">
                                    @Html.TextBoxFor(m => m.EmailTo, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-9 col-lg-9 col-md-12 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-12 col-sm-12 col-form-label text-small">Email Subject</label>
                                <div class="col-lg-12 col-md-12 col-sm-12">
                                    @Html.TextBoxFor(m => m.EmailSubject, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        @*<div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <label class="col-12 col-sm-12 col-form-label text-small">Email Address</label>
                                <div class="col-lg-12 col-md-12 col-sm-12">
                                    @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>*@

                        @*<div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 mb-0">
                                <div class="form-group row">
                                    <label class="col-lg-12 col-sm-12 col-form-label text-small">Expiary Date</label>
                                    <div class="col-lg-12 col-sm-12">
                                        @Html.TextBoxFor(m => m.date, new { @class = "form-control", @placeholder = "MM/DD/YYYY" })
                                    </div>
                                </div>
                            </div>*@

                    </div>
                    <div class="row">
                        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12 mb-0">
                            <div class="form-group row">
                                <div class="col-lg-12 col-md-12 col-sm-12">
                                    <button type="submit" class="btn btn-primary float-left">Save</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {

            $('#DateOfAssignment').datepicker({
                uiLibrary: 'bootstrap',
                "dateFormat": "mm/dd/yy"
            });
            $('#DueDate').datepicker({
                uiLibrary: 'bootstrap',
                "dateFormat": "mm/dd/yy"
            });
            $('#DateOfMeeting').datepicker({
                uiLibrary: 'bootstrap',
                "dateFormat": "mm/dd/yy"
            });
            $('#TakenNextDueDate').datepicker({
                uiLibrary: 'bootstrap',
                "dateFormat": "mm/dd/yy"
            });
            $('#DateOfMeeting').datepicker({
                uiLibrary: 'bootstrap',
                "dateFormat": "mm/dd/yy"
            });

            $('select').select2({
                width: '100%',
                selectOnClose: true
            });
        });
    </script>
}
